# Allowlist mode: nothing is tracked unless it is listed below.
# Local docs (the future documentation site), agent scaffolding, progress notes,
# downloads and ad-hoc probes stay untracked even when they exist on disk.
*
# Directories this repository owns; everything else is never descended into.
!/src/
!/lib/
!/test/
!/locale/
# Files required to build, install, publish or work in this repository.
!/.gitignore
!/LICENSE
!/README.md
!/cordis.patch.yml
!/package.json
!/package-lock.json
!/tsconfig.json
# Contents of the owned directories.
!/src/**
!/lib/**
!/test/**
!/locale/**
# Root-level local-only files that must never enter the repository.
/src/x.ts
/lib/x.*
/out.md
/agents.md
